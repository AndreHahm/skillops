{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillops.dev/schemas/health.schema.json",
  "title": "SkillOps Health Registry",
  "type": "object",
  "required": ["version", "health"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "health": {
      "type": "object",
      "required": ["scoring_model", "max_score"],
      "additionalProperties": false,
      "properties": {
        "scoring_model": {
          "type": "string",
          "minLength": 1
        },
        "max_score": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false
}

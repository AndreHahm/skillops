{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillops.dev/schemas/golden-set.schema.json",
  "title": "SkillOps Golden Set",
  "description": "Static golden scenarios for reviewing expected skill behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "skill_id", "cases"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "input", "expected"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string",
            "enum": [
              "happy_path",
              "edge_case",
              "invalid_input",
              "scope_creep",
              "safety_sensitive"
            ]
          },
          "input": {
            "type": "string",
            "minLength": 10
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "contains": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "not_contains": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "must_reference": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

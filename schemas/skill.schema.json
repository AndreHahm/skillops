{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillops.dev/schemas/skill.schema.json",
  "title": "SkillOps Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "status",
    "risk_tier",
    "description",
    "owner",
    "type",
    "compatibility",
    "dependencies",
    "allowed_tools",
    "evals",
    "provenance",
    "paths"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?(\\+[A-Za-z0-9.-]+)?$"
    },
    "status": {
      "enum": ["draft", "candidate", "reviewed", "stable", "deprecated", "archived"]
    },
    "risk_tier": {
      "enum": ["low", "medium", "high", "restricted"]
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contact"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "execution"],
      "properties": {
        "category": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          ]
        },
        "execution": {
          "enum": [
            "instruction-only",
            "script-backed",
            "tool-mediated",
            "mcp-enhanced",
            "subagent-spawning"
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "environments"],
      "properties": {
        "agents": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "environments": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "tools", "mcp_servers"],
      "properties": {
        "skills": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "tools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "mcp_servers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "allowed_tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shell", "filesystem"],
      "properties": {
        "shell": {
          "enum": ["read-only", "read-write", "none"]
        },
        "filesystem": {
          "enum": ["read-only", "read-write", "none"]
        }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "status"],
      "properties": {
        "suite_id": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["not-configured", "planned", "passing", "failing", "deprecated"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license"],
      "properties": {
        "source": {
          "enum": ["internal", "third-party", "fork", "generated", "unknown"]
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_file"],
      "properties": {
        "skill_file": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
